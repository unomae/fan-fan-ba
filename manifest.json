{
  "manifest_version": 3,
  "name": "翻翻吧",
  "version": "1.5.0",
  "description": "選取文字後使用AI 翻譯、解釋、優化改寫",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://texttospeech.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "models.js",
        "content/state.js",
        "content/utils.js",
        "content/obsidian.js",
        "content/toolbar.js",
        "content/result-card.js",
        "content/page-translator.js",
        "content/floating-ball.js",
        "content/main.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "翻翻吧",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/jf-openhuninn-2.1.ttf", "icons/icon48.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
